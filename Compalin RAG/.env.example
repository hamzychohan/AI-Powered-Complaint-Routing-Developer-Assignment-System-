# LLM API Settings
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_PROVIDER=groq  # options: groq, openai, anthropic
LLM_MODEL=llama-3.3-70b-versatile  # options: llama-3.3-70b-versatile, gpt-4o, claude-3-5-sonnet-latest

# Embedder Settings
EMBEDDING_MODEL=BAAI/bge-m3

# Vector Database Settings
VECTOR_DB_TYPE=chroma  # options: chroma, pgvector
CHROMA_DB_DIR=./data/chroma_db
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/complaint_rag

# Jira Integration Settings (Optional: leave blank for built-in Mock Adapter)
JIRA_SERVER_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=COMP

# Local Database
SQLITE_DB_PATH=./data/audit_logs.db
